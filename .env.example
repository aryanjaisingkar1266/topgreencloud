# Supply a PostgreSQL URL through the process environment before using the database.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
JWT_SECRET=replace-with-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Leave empty for stateless local parsing. Use ADC; no service-account keys needed.
# Production bucket must enforce public access prevention and uniform bucket-level access.
GCS_BUCKET=
